# EditorConfig — 跨编辑器代码风格统一
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Go
[*.go]
indent_style = tab
indent_size = 4

# Markdown
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON
[*.json]
indent_style = space
indent_size = 2

# Vue/HTML/CSS/JS/TS
[*.{vue,html,css,scss,js,jsx,ts,tsx,mjs}]
indent_style = tab
indent_size = 2

# Shell scripts
[*.{sh,bat,cmd,ps1}]
indent_style = space
indent_size = 4
end_of_line = lf

# Dockerfile
[Dockerfile]
indent_style = space
indent_size = 4

# Makefile
[Makefile]
indent_style = tab
indent_size = 4

# Git
[.gitignore]
indent_style = space
indent_size = 2
